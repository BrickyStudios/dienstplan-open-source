# ── Nurvo-App-spezifische ENV (an die kombinierte .env anhängen) ──────────────────────────────
# Ergänzt die Supabase-.env (siehe README). Domains anpassen!

# Öffentliche Domains (DNS zeigt auf euren Server)
APP_DOMAIN=app.nurvo.app
DB_DOMAIN=db.nurvo.app

# Daraus abgeleitet — MÜSSEN https:// + die Domains von oben sein:
SITE_URL=https://app.nurvo.app
NEXT_PUBLIC_SUPABASE_URL=https://db.nurvo.app
API_EXTERNAL_URL=https://db.nurvo.app       # Supabase erwartet das ebenfalls

# ANON_KEY / SERVICE_ROLE_KEY / CRON_SECRET / MOBILE_AUTH_SECRET / ANALYTICS_HASH_SECRET
# kommen aus gen-keys.mjs (nicht hier doppeln).

# E-Mail (DSGVO: EU-Anbieter statt US-Resend empfohlen). Ohne E-Mail funktionieren
# Einladungen/Benachrichtigungen nicht.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nurvo <einladung@euredomain.de>

# Sicherheitswacht (lib/sicherheit/): Empfaenger der Angriffs-Mails (sonst INBOUND_NOTIFY_TO)
SICHERHEIT_MELDUNG_AN=
# IPs, die nie gesperrt werden, Komma-getrennt (eigenes Buero, Kliniknetz hinter einer Adresse)
SICHERHEIT_IP_ERLAUBT=
# WICHTIG: Der Reverse Proxy muss X-Real-IP setzen, sonst sieht die Wacht nur "unknown" und sperrt nie.

# KI — heute Anthropic-Cloud (US!). Für vollen DSGVO-Selfhost auf lokales Ollama/Gemma umstellen:
#   AI_PROVIDER=openai
#   AI_BASE_URL=http://<ollama-host>:11434/v1
#   AI_MODEL=gemma2:9b
#   AI_API_KEY=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Demo-Login-Konten (optional)
DEMO_LEITUNG_EMAIL=
DEMO_MITARBEITER_EMAIL=
